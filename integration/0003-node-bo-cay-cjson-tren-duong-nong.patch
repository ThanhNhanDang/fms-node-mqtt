+
+bool gpio_out_execute_command(const char *ch_code, const char *op,
+                              bool has_value, double value,
+                              char *detail, size_t detail_sz)
+{
+    const cfg_channel_t *ch = cfg_channel_by_code(ch_code);
+    if (ch == NULL) {
+        snprintf(detail, detail_sz, "khong biet kenh '%s'",
+                 (ch_code && ch_code[0]) ? ch_code : "?");
+        return false;
+    }
+    if (ch->bus != BUS_GPIO || ch->io_mode != IO_OUTPUT) {
+        snprintf(detail, detail_sz, "kenh '%s' khong phai GPIO output — "
+                 "firmware nay chua ho tro dieu khien tu xa cho no", ch_code);
+        return false;
+    }
+    if (op == NULL || strcmp(op, "write") != 0) {
+        snprintf(detail, detail_sz, "kenh GPIO output chi ho tro cmd=write");
+        return false;
+    }
+    int level = has_value ? (value != 0) : 0;
+    if (!gpio_out_write(ch, level)) {
+        snprintf(detail, detail_sz, "ghi GPIO that bai");
+        return false;
+    }
+    detail[0] = '\0';
+    return true;
+}
